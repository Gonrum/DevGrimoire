#!/usr/bin/env bash
# dg — DevGrimoire workspace CLI.
# Talks to the backend's /internal/dg/* endpoints using a project-scoped JWT
# that's auto-injected at every workspace_exec call (T-168). Token TTL is 1h
# and refreshed on every exec, so a long agent session never sees an expired
# token under normal usage.
#
# Required env (auto-injected — DON'T set manually):
#   DG_API_URL       e.g. http://backend:3000/api/internal/dg
#   DG_API_TOKEN     scoped JWT
#   DG_WORKSPACE_ID  this workspace's MongoDB ID
#   DG_PROJECT_ID    the workspace's project ID
#
# Subcommands:
#   dg save <path> [--description=...] [--tags=a,b] [--filename=name]
#                  [--entity-type=todo --entity-id=<id>]
#   dg log <level> <message>          (level = debug|info|warn|error)
#   dg note <topic> <content>         (or:  dg note <topic> -f <file>)
#   dg todo <title> [--description=...] [--priority=low|medium|high|critical]
#                   [--tags=a,b] [--milestone=<id>]
#   dg kube clusters|get|describe|logs|events|top   (read-only, see dg kube --help)
#   dg whoami
#   dg --help | dg --version

set -euo pipefail

DG_VERSION="0.2.0"

usage() {
    cat <<'EOF'
dg — DevGrimoire workspace CLI

  dg save <path> [--description=X] [--tags=a,b] [--filename=name]
                 [--entity-type=todo --entity-id=<id>]
  dg log <level> <message>          (level = debug|info|warn|error)
  dg note <topic> <content>
  dg note <topic> -f <file>
  dg todo <title> [--description=X] [--priority=low|medium|high|critical]
                  [--tags=a,b] [--milestone=<id>]
  dg kube …                         (read-only cluster access, see: dg kube --help)
  dg whoami
  dg --help | dg --version

Configured via DG_* env vars (auto-injected per workspace_exec call and
into interactive terminals).
EOF
}

require_env() {
    if [[ -z "${DG_API_URL:-}" || -z "${DG_API_TOKEN:-}" ]]; then
        echo "error: DG_API_URL / DG_API_TOKEN missing — dg only works inside a workspace exec call or terminal (auto-injected)." >&2
        exit 2
    fi
}

# JSON-encode a single string for embedding in payloads. Uses python3 because
# it's already in the base image and handles unicode/special chars correctly.
json_encode() {
    python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
}

# Comma-separated list → JSON array of strings.
json_encode_list() {
    local IFS=','
    read -ra parts <<<"$1"
    python3 -c '
import json, sys
parts = [p.strip() for p in sys.argv[1:] if p.strip()]
sys.stdout.write(json.dumps(parts))' "${parts[@]}"
}

# Pretty-print a successful response. Exits non-zero on HTTP error and prints
# a clean error line — no JSON dump unless DG_DEBUG=1.
api_post() {
    local endpoint="$1"
    local payload="$2"
    local resp
    local status
    resp=$(curl -sS -w '\n%{http_code}' -X POST \
        -H "Authorization: Bearer ${DG_API_TOKEN}" \
        -H "Content-Type: application/json" \
        --data-raw "$payload" \
        "${DG_API_URL}/${endpoint}") || {
            echo "error: network failure calling ${endpoint}" >&2
            exit 1
        }
    status="${resp##*$'\n'}"
    body="${resp%$'\n'*}"
    if [[ "$status" -ge 200 && "$status" -lt 300 ]]; then
        echo "$body"
        return 0
    fi
    if [[ -n "${DG_DEBUG:-}" ]]; then
        echo "error (HTTP $status): $body" >&2
    else
        local msg
        msg=$(echo "$body" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    m = d.get("message", "")
    if isinstance(m, list): m = "; ".join(str(x) for x in m)
    sys.stdout.write(m or d.get("error", "unknown error"))
except Exception:
    sys.stdout.write("HTTP %d" % '"$status"')' 2>/dev/null) || msg="HTTP $status"
        echo "error: ${msg:-HTTP $status}" >&2
    fi
    exit 1
}

# Resolve a user-provided path (relative to cwd) into a path relative to the
# workspace root. The sidecar /read-base64 expects workspace-root-relative.
resolve_workspace_path() {
    local input="$1"
    if [[ -z "${DG_WORKSPACE_ID:-}" ]]; then
        # Fall back to whatever the user gave us — backend will validate.
        echo "$input"
        return
    fi
    local root="/workspaces/${DG_WORKSPACE_ID}"
    local abs
    if [[ "$input" = /* ]]; then
        abs="$input"
    else
        abs="$(cd "$(dirname "$input")" 2>/dev/null && pwd)/$(basename "$input")"
    fi
    case "$abs" in
        "$root"/*) echo "${abs#$root/}" ;;
        "$root") echo "." ;;
        *) echo "$input" ;;  # leave as-is, backend will 400 if outside
    esac
}

cmd_save() {
    local path="" desc="" tags="" filename="" etype="" eid=""
    if [[ $# -eq 0 ]]; then
        echo "usage: dg save <path> [--description=...] [--tags=a,b] [--filename=name] [--entity-type=todo --entity-id=<id>]" >&2
        exit 2
    fi
    path="$1"; shift
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --description=*) desc="${1#*=}" ;;
            --description)   desc="$2"; shift ;;
            --tags=*)        tags="${1#*=}" ;;
            --tags)          tags="$2"; shift ;;
            --filename=*)    filename="${1#*=}" ;;
            --filename)      filename="$2"; shift ;;
            --entity-type=*) etype="${1#*=}" ;;
            --entity-type)   etype="$2"; shift ;;
            --entity-id=*)   eid="${1#*=}" ;;
            --entity-id)     eid="$2"; shift ;;
            *) echo "unknown flag: $1" >&2; exit 2 ;;
        esac
        shift
    done
    require_env
    local rel
    rel=$(resolve_workspace_path "$path")
    local payload="{\"path\":$(json_encode "$rel")"
    [[ -n "$filename" ]] && payload+=",\"fileName\":$(json_encode "$filename")"
    [[ -n "$desc" ]]     && payload+=",\"description\":$(json_encode "$desc")"
    [[ -n "$etype" ]]    && payload+=",\"entityType\":$(json_encode "$etype")"
    [[ -n "$eid" ]]      && payload+=",\"entityId\":$(json_encode "$eid")"
    [[ -n "$tags" ]]     && payload+=",\"tags\":$(json_encode_list "$tags")"
    payload+="}"
    api_post save "$payload"
}

cmd_log() {
    if [[ $# -lt 2 ]]; then
        echo "usage: dg log <level> <message>" >&2
        exit 2
    fi
    local level="$1"; shift
    local message="$*"
    require_env
    local payload
    payload="{\"level\":$(json_encode "$level"),\"message\":$(json_encode "$message")}"
    api_post log "$payload"
}

cmd_note() {
    if [[ $# -lt 2 ]]; then
        echo "usage: dg note <topic> <content>   (or: dg note <topic> -f <file>)" >&2
        exit 2
    fi
    local topic="$1"; shift
    local content
    if [[ "$1" = "-f" ]]; then
        if [[ $# -lt 2 ]]; then
            echo "error: -f requires a file path" >&2; exit 2
        fi
        content="$(<"$2")"
    else
        content="$*"
    fi
    require_env
    local payload
    payload="{\"topic\":$(json_encode "$topic"),\"content\":$(json_encode "$content")}"
    api_post note "$payload"
}

cmd_todo() {
    if [[ $# -lt 1 ]]; then
        echo "usage: dg todo <title> [--description=X] [--priority=...] [--tags=a,b] [--milestone=<id>]" >&2
        exit 2
    fi
    local title="$1"; shift
    local desc="" priority="" tags="" milestone=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --description=*) desc="${1#*=}" ;;
            --description)   desc="$2"; shift ;;
            --priority=*)    priority="${1#*=}" ;;
            --priority)      priority="$2"; shift ;;
            --tags=*)        tags="${1#*=}" ;;
            --tags)          tags="$2"; shift ;;
            --milestone=*)   milestone="${1#*=}" ;;
            --milestone)     milestone="$2"; shift ;;
            *) echo "unknown flag: $1" >&2; exit 2 ;;
        esac
        shift
    done
    require_env
    local payload="{\"title\":$(json_encode "$title")"
    [[ -n "$desc" ]]      && payload+=",\"description\":$(json_encode "$desc")"
    [[ -n "$priority" ]]  && payload+=",\"priority\":$(json_encode "$priority")"
    [[ -n "$milestone" ]] && payload+=",\"milestoneId\":$(json_encode "$milestone")"
    [[ -n "$tags" ]]      && payload+=",\"tags\":$(json_encode_list "$tags")"
    payload+="}"
    api_post todo "$payload"
}

kube_usage() {
    cat <<'EOF'
dg kube — read-only access to this project's Kubernetes clusters.
The cluster credentials stay in the DevGrimoire backend; there is no
kubeconfig in this workspace.

  dg kube clusters
  dg kube get <kind> [name] [-n ns | -A] [-l selector] [--limit N]
  dg kube describe <kind> <name> [-n ns]
  dg kube logs <pod> -n ns [-c container] [--tail N] [--since SECONDS] [--previous]
  dg kube events [-n ns] [--for name] [--kind kind] [--limit N]
  dg kube top [pods|nodes] [-n ns]

Every command takes --cluster <slug|id>; it may be omitted when the project
has exactly one cluster. Output is JSON (logs: plain lines).
EOF
}

# Parses the shared flags into the K_* globals; positional args land in KPOS.
kube_parse() {
    K_CLUSTER="" K_NS="" K_SEL="" K_LIMIT="" K_CONTAINER="" K_TAIL="" K_SINCE="" K_PREV="" K_FOR="" K_KIND=""
    KPOS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cluster=*)    K_CLUSTER="${1#*=}" ;;
            --cluster)      K_CLUSTER="${2:-}"; shift ;;
            -n|--namespace) K_NS="${2:-}"; shift ;;
            -A|--all-namespaces) K_NS="" ;;   # kubectl habit; no -n already means all
            --namespace=*)  K_NS="${1#*=}" ;;
            -l|--selector)  K_SEL="${2:-}"; shift ;;
            --selector=*)   K_SEL="${1#*=}" ;;
            --limit=*)      K_LIMIT="${1#*=}" ;;
            --limit)        K_LIMIT="${2:-}"; shift ;;
            -c|--container) K_CONTAINER="${2:-}"; shift ;;
            --container=*)  K_CONTAINER="${1#*=}" ;;
            --tail=*)       K_TAIL="${1#*=}" ;;
            --tail)         K_TAIL="${2:-}"; shift ;;
            --since=*)      K_SINCE="${1#*=}" ;;
            --since)        K_SINCE="${2:-}"; shift ;;
            -p|--previous)  K_PREV=1 ;;
            --for=*)        K_FOR="${1#*=}" ;;
            --for)          K_FOR="${2:-}"; shift ;;
            --kind=*)       K_KIND="${1#*=}" ;;
            --kind)         K_KIND="${2:-}"; shift ;;
            -*) echo "unknown flag: $1" >&2; exit 2 ;;
            *) KPOS+=("$1") ;;
        esac
        shift
    done
}

# Integer flag value → JSON number, or exit with a usage error.
json_int() {
    if [[ ! "$2" =~ ^[0-9]+$ ]]; then
        echo "error: $1 must be a positive integer" >&2; exit 2
    fi
    echo "$2"
}

# Builds the request body from key/JSON-value pairs plus --cluster.
kube_payload() {
    local payload="{" sep=""
    if [[ -n "$K_CLUSTER" ]]; then payload+="\"cluster\":$(json_encode "$K_CLUSTER")"; sep=","; fi
    while [[ $# -gt 1 ]]; do
        payload+="${sep}\"$1\":$2"; sep=","
        shift 2
    done
    echo "${payload}}"
}

pretty_json() {
    python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin), indent=2, ensure_ascii=False))'
}

print_log_lines() {
    python3 -c '
import json, sys
d = json.load(sys.stdin)
for line in d.get("lines", []):
    print(line)
if d.get("status") != "complete":
    err = d.get("error")
    print("# status: %s%s" % (d.get("status"), (" - " + err) if err else ""), file=sys.stderr)'
}

# kubectl-style names (pods, po, deploy, svc …) → the backend's kind names.
# Unknown values pass through unchanged; the backend rejects them with a list.
kube_kind() {
    case "${1,,}" in
        ns|namespace|namespaces)                     echo Namespace ;;
        no|node|nodes)                               echo Node ;;
        po|pod|pods)                                 echo Pod ;;
        svc|service|services)                        echo Service ;;
        cm|configmap|configmaps)                     echo ConfigMap ;;
        secret|secrets)                              echo Secret ;;
        pvc|persistentvolumeclaim|persistentvolumeclaims) echo PersistentVolumeClaim ;;
        ev|event|events)                             echo Event ;;
        deploy|deployment|deployments)               echo Deployment ;;
        sts|statefulset|statefulsets)                echo StatefulSet ;;
        ds|daemonset|daemonsets)                     echo DaemonSet ;;
        job|jobs)                                    echo Job ;;
        cj|cronjob|cronjobs)                         echo CronJob ;;
        ing|ingress|ingresses)                       echo Ingress ;;
        *)                                           echo "$1" ;;
    esac
}

cmd_kube() {
    local sub="${1:-}"
    [[ $# -gt 0 ]] && shift
    case "$sub" in
        -h|--help|help|"") kube_usage; return 0 ;;
    esac
    kube_parse "$@"
    require_env
    local extra=()
    [[ -n "$K_NS" ]] && extra+=(namespace "$(json_encode "$K_NS")")
    local body
    case "$sub" in
        clusters)
            body=$(api_post kube/clusters "$(kube_payload)")
            pretty_json <<<"$body" ;;
        get)
            if [[ ${#KPOS[@]} -lt 1 ]]; then echo "usage: dg kube get <kind> [name] [-n ns] [-l selector]" >&2; exit 2; fi
            extra+=(kind "$(json_encode "$(kube_kind "${KPOS[0]}")")")
            [[ ${#KPOS[@]} -ge 2 ]] && extra+=(name "$(json_encode "${KPOS[1]}")")
            [[ -n "$K_SEL" ]] && extra+=(labelSelector "$(json_encode "$K_SEL")")
            [[ -n "$K_LIMIT" ]] && extra+=(limit "$(json_int --limit "$K_LIMIT")")
            body=$(api_post kube/get "$(kube_payload "${extra[@]}")")
            pretty_json <<<"$body" ;;
        describe)
            if [[ ${#KPOS[@]} -lt 2 ]]; then echo "usage: dg kube describe <kind> <name> [-n ns]" >&2; exit 2; fi
            extra+=(kind "$(json_encode "$(kube_kind "${KPOS[0]}")")" name "$(json_encode "${KPOS[1]}")")
            body=$(api_post kube/describe "$(kube_payload "${extra[@]}")")
            pretty_json <<<"$body" ;;
        logs)
            if [[ ${#KPOS[@]} -lt 1 || -z "$K_NS" ]]; then
                echo "usage: dg kube logs <pod> -n ns [-c container] [--tail N] [--since SECONDS] [--previous]" >&2; exit 2
            fi
            extra+=(pod "$(json_encode "${KPOS[0]}")")
            [[ -n "$K_CONTAINER" ]] && extra+=(container "$(json_encode "$K_CONTAINER")")
            [[ -n "$K_TAIL" ]] && extra+=(tailLines "$(json_int --tail "$K_TAIL")")
            [[ -n "$K_SINCE" ]] && extra+=(sinceSeconds "$(json_int --since "$K_SINCE")")
            [[ -n "$K_PREV" ]] && extra+=(previous true)
            body=$(api_post kube/logs "$(kube_payload "${extra[@]}")")
            print_log_lines <<<"$body" ;;
        events)
            [[ -n "$K_FOR" ]] && extra+=(involvedName "$(json_encode "$K_FOR")")
            [[ -n "$K_KIND" ]] && extra+=(involvedKind "$(json_encode "$(kube_kind "$K_KIND")")")
            [[ -n "$K_LIMIT" ]] && extra+=(limit "$(json_int --limit "$K_LIMIT")")
            body=$(api_post kube/events "$(kube_payload "${extra[@]}")")
            pretty_json <<<"$body" ;;
        top)
            [[ ${#KPOS[@]} -ge 1 ]] && extra+=(scope "$(json_encode "${KPOS[0]}")")
            body=$(api_post kube/top "$(kube_payload "${extra[@]}")")
            pretty_json <<<"$body" ;;
        *) echo "unknown kube subcommand: $sub" >&2; kube_usage >&2; exit 2 ;;
    esac
}

cmd_whoami() {
    require_env
    api_post whoami "{}"
}

case "${1:-}" in
    save)        shift; cmd_save "$@" ;;
    log)         shift; cmd_log "$@" ;;
    note)        shift; cmd_note "$@" ;;
    todo)        shift; cmd_todo "$@" ;;
    kube)        shift; cmd_kube "$@" ;;
    whoami)      shift; cmd_whoami ;;
    -h|--help|help|"") usage ;;
    -v|--version) echo "dg ${DG_VERSION}" ;;
    *) echo "unknown subcommand: $1" >&2; usage >&2; exit 2 ;;
esac
