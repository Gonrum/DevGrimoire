# MongoDB
MONGO_USER=devgrimoire
MONGO_PASSWORD=change_me_in_production
MONGO_DB=devgrimoire
MONGODB_URI=mongodb://devgrimoire:change_me_in_production@mongodb:27017/devgrimoire?authSource=admin

# Standalone mode (set by docker-compose.standalone.yml, or manually for non-Docker setups)
# MONGODB_STANDALONE=true

# Authentication (leave empty to disable auth entirely)
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me_in_production
JWT_SECRET=change_me_generate_a_random_string

# Workspace sidecar (required by docker-compose.yml)
# Generate with: openssl rand -hex 32
WORKSPACE_API_TOKEN=change_me_generate_a_random_32_byte_token

# Secrets encryption (required for secret_set / encrypted secrets)
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# Web Push notifications (optional)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Chat LLM (optional — projektbezogener Chat in der Oberfläche)
# Provider-Optionen: lmstudio | openai-compatible | anthropic | openai
# Default-URLs pro Provider:
#   lmstudio          → http://localhost:1234      (API-Key optional)
#   openai-compatible → http://localhost:1234      (API-Key optional, für vLLM/TGI/Ollama's /v1-Shim etc.)
#   anthropic         → https://api.anthropic.com  (API-Key PFLICHT, sk-ant-...)
#   openai            → https://api.openai.com     (API-Key PFLICHT, sk-...)
#
# Hinweis Ollama: der native 'ollama'-Provider wurde entfernt. Für Ollama nutze
# 'openai-compatible'. Wenn Backend im Docker läuft und Ollama auf dem Host,
# verwende http://host.docker.internal:11434; bei lokalem Backend ist
# http://localhost:11434 korrekt. Das trifft Ollama's
# /v1/chat/completions-Shim (verfügbar seit Ollama 0.3, inkl. Function-Calling und Vision).
# Bestehende Configs mit provider=ollama werden beim ersten Start automatisch migriert.
#
# Primary Endpoint (z.B. LM Studio mit GPU)
CHAT_LLM_PROVIDER=lmstudio
CHAT_LLM_URL=http://localhost:1234
CHAT_LLM_MODEL=google/gemma-3-4b
# CHAT_LLM_API_KEY=          # Nur für anthropic/openai (oder LM Studio mit Auth). Bei Settings-DB-Konfiguration verschlüsselt gespeichert — hier nur als Env-Fallback.
# CHAT_LLM_TEMPERATURE=0.7
# CHAT_LLM_MAX_TOKENS=2048
# CHAT_LLM_TOP_K=6
# CHAT_LLM_HISTORY_LIMIT=10
# Fallback (optional, z.B. Ollama auf CPU wenn die Cloud nicht erreichbar ist)
# CHAT_LLM_FALLBACK_PROVIDER=openai-compatible
# CHAT_LLM_FALLBACK_URL=http://host.docker.internal:11434
# CHAT_LLM_FALLBACK_MODEL=llama3.2:3b
# CHAT_LLM_FALLBACK_API_KEY=
# Alternativ: Alle Endpoints in einer Zeile (überschreibt Einzel-Vars, keine API-Keys hier)
# CHAT_LLM_ENDPOINTS=openai-compatible|http://gpu:1234|google/gemma-3-4b,openai-compatible|http://host.docker.internal:11434|llama3.2:3b
#
# Hinweis: API-Keys werden in der Settings-DB via SECRETS_ENCRYPTION_KEY (AES-256-GCM)
# verschlüsselt. Cloud-Provider ohne konfigurierten SECRETS_ENCRYPTION_KEY schlagen beim
# Speichern fehl — setze den Key VOR der Erst-Konfiguration von Anthropic/OpenAI.

# Chat Tool-Calling (optional — braucht Tool-fähiges Modell, z.B. Qwen 2.5 7B Instruct oder Llama 3.1 8B)
# CHAT_LLM_TOOLS_ENABLED=false
# CHAT_LLM_TOOLS_ALLOWLIST=rag_search,knowledge_search,knowledge_get,todo_list,milestone_list
# CHAT_LLM_TOOLS_MAX_ITERATIONS=5

# Web Search (MCP web_search / web_fetch via self-hosted SearXNG)
# Die SearXNG-Instanz läuft intern im Compose-Netzwerk (kein externer Port).
# SEARXNG_SECRET: zufälliger 32+ Zeichen String — generiere via `openssl rand -hex 32`.
SEARXNG_SECRET=change-me-openssl-rand-hex-32
# SEARXNG_URL wird im Compose-Netz automatisch auf http://searxng:8080 gesetzt; hier nur überschreiben wenn du eine externe Instanz nutzt.
# SEARXNG_URL=http://searxng:8080

# MinIO / S3-compatible object storage (optional but required for attachments and backups)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=devgrimoire
MINIO_USE_SSL=false

# System backups (stored in MinIO/S3)
# Runs every morning at 06:00 server time by default.
BACKUP_DAILY_ENABLED=true
BACKUP_CRON=0 6 * * *
BACKUP_MINIO_BUCKET=devgrimoire-backups
