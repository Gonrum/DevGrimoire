# DevGrimoire — Jetson Nano Environment
# Copy to .env.jetson and adjust values

MONGO_USER=devgrimoire
MONGO_PASSWORD=change-me-secure-password
MONGO_DB=devgrimoire
MONGODB_URI=mongodb://devgrimoire:change-me-secure-password@mongodb:27017/devgrimoire?authSource=admin

AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-secure-password
JWT_SECRET=change-me-random-jwt-secret

# Must match the master instance for replication!
SECRETS_ENCRYPTION_KEY=change-me-64-char-hex-key

# MinIO credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-secure-password
MINIO_BUCKET=devgrimoire

# Optional: external RAG fallback (e.g. LM Studio on desktop)
# RAG_FALLBACK_PROVIDER=openai-compatible
# RAG_FALLBACK_URL=http://192.168.x.x:1234
# RAG_FALLBACK_MODEL=text-embedding-nomic-embed-text-v2-moe

# SearXNG secret (min. 32 chars — generate via `openssl rand -hex 32`)
SEARXNG_SECRET=change-me-openssl-rand-hex-32
